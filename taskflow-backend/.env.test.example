# Copy this to .env.test (git-ignored) and adjust if needed.
#
# IMPORTANT: this must point at a SEPARATE database from your dev DATABASE_URL.
# The integration tests TRUNCATE every table before each test — pointing this
# at your dev database (the one with seeded Ava/Liam/etc. data) will wipe it.
#
# One-time setup, with postgres already running via `docker compose up -d postgres`:
#   docker compose exec postgres psql -U taskflow -d taskflow -c "CREATE DATABASE taskflow_test;"
#   npm run test:migrate

NODE_ENV=test
PORT=3000

DATABASE_URL=postgresql://taskflow:change_me@localhost:5433/taskflow_test
POSTGRES_DB=taskflow_test
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change_me

REDIS_HOST=localhost
REDIS_PORT=6379

# Test-only secrets — never used for real tokens, fine to keep as-is.
JWT_SECRET=test-only-jwt-secret-do-not-use-in-production-0000000000000
JWT_REFRESH_SECRET=test-only-refresh-secret-do-not-use-in-production-000000
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

BCRYPT_ROUNDS=12
EMAIL_PROVIDER=console
