# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change_this

# Host-side Prisma / local development
# When API/Worker run inside Docker, docker-compose.yml constructs
# the internal URL using postgres:5432.
DATABASE_URL=postgresql://taskflow:change_this@localhost:5433/taskflow

# Redis
# Used when running the API/worker directly on the host.
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# Generate strong random values for local/prod environments.
# Example:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_random_64_byte_hex
JWT_REFRESH_SECRET=replace_with_different_random_64_byte_hex

# Token lifetimes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Password hashing
BCRYPT_ROUNDS=12

# Email
# Development/testing provider. Does not send real email.
EMAIL_PROVIDER=console